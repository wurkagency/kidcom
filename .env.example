# ---- Shared ----
NODE_ENV=development

# ---- Database (packages/db, apps/api) ----
# Local dev (docker-compose): postgres user/pass/db all "kidcom"
DATABASE_URL=postgresql://kidcom:kidcom@localhost:5432/kidcom

# ---- Redis / BullMQ (apps/api) ----
REDIS_URL=redis://localhost:6379

# ---- API (apps/api) ----
PORT=4000
SESSION_SECRET=change-me-in-prod
# Comma-separated list of origins allowed to send credentialed requests (web app origin(s))
CORS_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost

# ---- Web (apps/web) ----
# Where the SPA should send API requests in dev (proxied in prod via api.kidcom.org)
VITE_API_URL=http://localhost:4000

# ---- QuickPay (apps/api, later chunk) ----
QUICKPAY_API_KEY=
QUICKPAY_PRIVATE_KEY=

# ---- Web Push / VAPID (apps/api, later chunk) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:charlie@wurk.dk

# ---- Local media storage (apps/api) ----
MEDIA_STORAGE_PATH=./media

# ---- SMTP / transactional email (apps/api) ----
# Leave all blank in local dev — emails are logged to the console instead of
# sent (see apps/api/src/lib/mailSender.ts). Set all of these in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KidCom" <noreply@kidcom.org>

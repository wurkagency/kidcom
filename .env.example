# ---- Shared ----
NODE_ENV=development

# ---- Database (packages/db, apps/api) ----
# Local dev (docker-compose): postgres user/pass/db all "kinnd"
DATABASE_URL=postgresql://kinnd:kinnd@localhost:5432/kinnd

# ---- Redis / BullMQ (apps/api) ----
REDIS_URL=redis://localhost:6379

# ---- API (apps/api) ----
PORT=4000
SESSION_SECRET=change-me-in-prod
# Comma-separated origins allowed to send credentialed requests. The FIRST one
# is the app's own origin: invite links and QuickPay's return URL use it.
CORS_ORIGIN=http://localhost:5173
# Leave unset: the session cookie then belongs to the app's host only (the API
# is served under https://<app host>/api, same origin). Setting it to e.g.
# kinnd.eu would also send the cookie to every *.kinnd.eu host (manage., the website).
# COOKIE_DOMAIN=
# The API's public base URL (QuickPay's payment callback is sent here).
# Production: https://<app host>/api
API_BASE_URL=http://localhost:4000
# Listen address. Production defaults to 127.0.0.1 (behind nginx) — leave unset.
# HOST=
# AES-256-GCM key for MedicalInfo field encryption at rest (GDPR Art. 9 —
# special-category health data about a minor). Any-length string works (a
# real key is derived via SHA-256 — see apps/api/src/lib/medicalEncryption.ts)
# but production must set a real random one: `openssl rand -hex 32`, same as
# SESSION_SECRET. Rotating it makes every existing encrypted row unreadable.
MEDICAL_INFO_ENCRYPTION_KEY=change-me-in-prod
# Only during a key rotation: old key(s), still readable (comma-separated);
# then `npm run medical:rekey --workspace=apps/api` (docs/deployment_guide.md §8.5).
MEDICAL_INFO_ENCRYPTION_KEYS_PREVIOUS=
# Production refuses to start on placeholder, development or short (<32
# characters) values of SESSION_SECRET, MEDICAL_INFO_ENCRYPTION_KEY and
# MEDIA_ENCRYPTION_KEY: generate each with `openssl rand -hex 32`.

# ---- Web (apps/web) ----
# Where the app sends API requests. Leave unset: "/api" (Vite proxies it in dev,
# nginx in production — docs/deployment_guide.md).
# VITE_API_BASE=/api

# ---- QuickPay (apps/api) ----
# With keys set, paid plans go through QuickPay (test keys = test payments).
QUICKPAY_API_KEY=
QUICKPAY_PRIVATE_KEY=
# QUICKPAY_BASE_URL=https://api.quickpay.net
# Production refuses QuickPay test-card authorisations unless this is "true".
# QUICKPAY_ACCEPT_TEST_CARDS=
# true = paid plans switch on without payment (a deployment still being tested).
BILLING_TEST_MODE=false

# ---- Web Push / VAPID (apps/api) — generate once: npx web-push generate-vapid-keys ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:charlie@wurk.dk

# ---- Local media storage (apps/api) ----
MEDIA_STORAGE_PATH=./media
# Master key for at-rest media encryption: openssl rand -hex 32. REQUIRED in
# production. Losing it makes every photo and video unrecoverable — back it up
# apart from the media (docs/deployment_guide.md → Media encryption).
MEDIA_ENCRYPTION_KEY=
# Old keys still readable during a rotation (comma-separated).
MEDIA_ENCRYPTION_KEYS_PREVIOUS=
# Worker's plaintext scratch folder while processing (default: OS temp).
MEDIA_TEMP_PATH=

# ---- SMTP / transactional email (apps/api) ----
# Leave all blank in local dev — emails are logged to the console instead of
# sent (see apps/api/src/lib/mailSender.ts). REQUIRED in production: the API
# refuses to start without SMTP_HOST, SMTP_USER and SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be a Brevo-verified sender. Brevo relay: SMTP_HOST=smtp-relay.brevo.com,
# SMTP_USER = the SMTP login, SMTP_PASS = the SMTP key (Brevo > SMTP & API).
SMTP_FROM="Kinnd" <no-reply@kinnd.eu>

# ---- OAuth sign-in (apps/api) ----
# Redirect URIs registered with each provider:
#   {OAUTH_REDIRECT_BASE}/auth/oauth/google/callback
#   {OAUTH_REDIRECT_BASE}/auth/oauth/microsoft/callback
OAUTH_REDIRECT_BASE=http://localhost:5173/api
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = work/school + personal Microsoft accounts
MICROSOFT_TENANT_ID=common

# ---- Brevo (apps/api) ----
# Transactional SMS (sign-up OTP, phone change, password reset) and email.
BREVO_API_KEY=
# Alphanumeric sender shown on SMS, max 11 characters, e.g. "Kinnd"
BREVO_SMS_SENDER=
BREVO_SMTP_KEY=
# SMS delivery: "brevo" sends real SMS (costs credits); "log" prints codes to
# the API log. Defaults: brevo in production, log elsewhere.
# SMS_DELIVERY=brevo
# Toll-fraud guard: most SMS in any 24 hours across all accounts (default 500).
# Reaching it pauses SMS and logs an [ALERT] line.
# SMS_DAILY_LIMIT=500
# SMTP relay login (Brevo account > SMTP & API)
BREVO_SMTP_LOGIN=

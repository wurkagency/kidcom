// SplitKid — initial data model (Chunk 1 scaffold)
// Covers PRD sections 1-6 at a first-pass level of detail. Fields will be
// refined as each feature chunk is built; nothing here is final.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / accounts
// ---------------------------------------------------------------------------

enum SubscriptionTier {
  FREE
  PARENTS
  FAMILY
}

enum AccessRole {
  PARENT
  GUARDIAN
  FAMILY
}

// The specific relationship shown in the UI ("Grandmother", "Dad", ...) —
// separate from AccessRole, which only controls permissions. Replaces
// FamilyMemberType (spec §1.3/§8, Phase 5) — see familyMemberTypeToRole's
// successor in packages/shared for the server-side relationship -> role
// mapping (the client never sends an AccessRole directly).
// CO_PARENT is gone (spec §1.2): it was a position relative to the other
// adult, not a relationship to the child — inviting a co-parent now means
// inviting someone as FATHER/MOTHER/PARENT directly.
// GRANDPARENT/AUNT_UNCLE/SIBLING/FOSTER_PARENT are gone too, superseded by
// the more specific values below (four grandparent values per 9.15;
// gendered foster/step pairs per 9.17/9.17a).
enum RelationshipType {
  FATHER
  MOTHER
  PARENT
  STEP_FATHER
  STEP_MOTHER
  FOSTER_FATHER
  FOSTER_MOTHER
  GUARDIAN
  GRANDFATHER_PAT
  GRANDFATHER_MAT
  GRANDMOTHER_PAT
  GRANDMOTHER_MAT
  UNCLE
  AUNT
  BROTHER
  SISTER
  CAREGIVER
  OTHER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?
  passwordHash    String
  firstName       String
  lastName        String
  avatarUrl       String?
  emailVerifiedAt DateTime?
  // I-2 (spec §2.2/§4.3): one 30-day trial per user, ever — granted at
  // account creation regardless of how the account was created (organic
  // signup or invite-accept), recorded here rather than on Subscription so
  // it survives plan changes and cancellations. During the window, this
  // user's own entitlement-coverage tier is treated as the max (FAMILY),
  // independent of their actual Subscription.tier/status — see
  // packages/shared/src/entitlement.ts's effectiveCoverageTier. Never reset
  // once set; there is no "renew my trial" path anywhere in this model.
  trialStartedAt  DateTime?
  trialEndsAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // The subscription a user owns (they pay for Parents/Family tier).
  ownedSubscription Subscription?

  childAccess    ChildAccess[]
  journalPosts   JournalPost[]
  comments       Comment[]
  journalReactions JournalReaction[]
  mediaAssets    MediaAsset[]
  avatarAsset    MediaAsset?       @relation("UserAvatar")
  listClaims     ListItem[]        @relation("ListItemClaimedBy")
  listAssignments ListItem[]       @relation("ListItemAssignedTo")
  sentInvites    Invite[]          @relation("InviteSentBy")
  personalNotes  PersonalNote[]
  messagesSent   Message[]         @relation("MessageSender")
  threadMembers  ThreadMember[]
  swapRequestsBy SwapRequest[]     @relation("SwapRequestedBy")
  calendarEventRequestsBy CalendarEventRequest[] @relation("CalendarEventRequestedBy")
  pushSubscriptions PushSubscription[]
  notificationPreferences NotificationPreferences?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  twoFactorCodes LoginTwoFactorCode[]
  calendarEventConfirmations CalendarEventConfirmation[]
  upgradeRequestsMade UpgradeRequest[]

  @@map("users")
}

// A single-use, short-lived token proving control of the account's email
// address. Only the sha256 hash is stored — same reasoning as never storing
// a raw password — so a DB read alone can't be used to verify someone
// else's account. Re-requesting verification replaces (deletes+recreates)
// this row rather than accumulating one per request.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

// Post-launch backlog Phase F — same hash-only/single-use/short-lived
// pattern as EmailVerificationToken above (a raw token is emailed once,
// only its sha256 hash is ever stored, re-requesting replaces the row
// rather than accumulating one per request). No password-reset flow
// existed at all before this — change-password required an active session
// + the current password, with no path for a locked-out user.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// A single-use, short-lived login OTP — the login-time counterpart to
// EmailVerificationToken above (same "only the hash is stored" reasoning).
// One active code per user (re-requesting via /auth/resend-2fa deletes and
// recreates, same pattern as EmailVerificationToken); `attempts` caps how
// many wrong guesses a holder of this row's userId gets before the code is
// forced to be regenerated, bounding brute-force over the 6-digit space.
model LoginTwoFactorCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("login_two_factor_codes")
}

model Invite {
  id          String     @id @default(cuid())
  token       String     @unique @default(cuid())
  email       String?
  phone       String?
  role        AccessRole
  relationship RelationshipType?
  invitedById String
  invitedBy   User       @relation("InviteSentBy", fields: [invitedById], references: [id])
  childId     String?
  child       Child?     @relation(fields: [childId], references: [id])
  acceptedAt  DateTime?
  trialEndsAt DateTime?
  createdAt   DateTime   @default(now())

  @@map("invites")
}

// ---------------------------------------------------------------------------
// Children & access control
// ---------------------------------------------------------------------------

enum ChildGender {
  BOY
  GIRL
  OTHER
}

model Child {
  id            String      @id @default(cuid())
  firstName     String
  lastName      String
  gender        ChildGender
  birthday      DateTime
  profileImageUrl String?
  heightCm      Float?
  clothingSize  String?
  shoeSize      String?
  countryCode   String      @default("DK")
  // Phase 10 (spec 9.21, §1.4a.4) — soft delete, 30-day restore window.
  // Nothing else in the schema reacts to this being set (no cascade, no
  // content removal — 9.11's "content stays with the child" already means
  // there was never a deletion cascade to begin with); it's purely a flag
  // the API reads to hide the child from normal use and to decide whether
  // POST .../restore is still within its window.
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  access             ChildAccess[]
  medicalInfo        MedicalInfo[]
  growthEntries      GrowthEntry[]
  custodyPlans       CustodyPlan[]
  calendarEvents     CalendarEvent[]
  swapRequests       SwapRequest[]
  calendarEventRequests CalendarEventRequest[]
  journalPostTags    JournalPostChild[]
  listItems          ListItem[]
  invites            Invite[]
  emergencyContacts  EmergencyContact[]
  scheduleOccurrences ChildScheduleOccurrence[]
  avatarAsset        MediaAsset?               @relation("ChildAvatar")
  upgradeRequests    UpgradeRequest[]
  deletionRequest    ChildDeletionRequest?

  @@map("children")
}

// Who can see/edit a given child, and at what role (parent vs extended family).
model ChildAccess {
  id        String     @id @default(cuid())
  childId   String
  child     Child      @relation(fields: [childId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AccessRole
  // Who this person is to the child, in the word the app prints (spec §1.2)
  // — e.g. GRANDMOTHER_MAT -> "Grandmother". Always set, including for the
  // account owner (self-declared at child-creation time, spec §1.3) —
  // unlike the old FamilyMemberType this replaces, there is no longer a
  // null case.
  relationship RelationshipType
  // Per-member opt-in for a FAMILY-role holder to view medical info/
  // allergies (spec §1.4) — special-category data about a minor (GDPR Art.
  // 9), so default-off rather than inherited from general child access.
  // Meaningless for PARENT (always full access) — a parent grants this
  // explicitly per member, not implied by role.
  medicalInfoAccess Boolean @default(false)
  // Phase 10 (spec 9.16) — a sibling's own account, created directly by a
  // parent (see POST /children/:childId/family/minor) rather than through
  // the normal email-invite flow. "Minor member" is a flag here, not a new
  // AccessRole — always paired with role FAMILY. Reduces the default FAMILY
  // grant further: journal/media/lists only, medical info always denied
  // regardless of medicalInfoAccess above (see lib/permissions.ts).
  isMinorMember Boolean @default(false)
  createdAt DateTime   @default(now())

  @@unique([childId, userId])
  @@map("child_access")
}

// Phase 6a (spec §1.5/9.20) — instrumented at the moment of every access
// grant (a child created directly, or an invite accepted). Deliberately
// carries NO childId/userId/email — nothing here can ever be joined back to
// a person, at the schema level, not just by convention in whatever query
// reads it later. Query this in aggregate only, with a minimum cohort size
// of 10 (spec 9.20) — e.g. `GROUP BY relationship HAVING count(*) >= 10`.
// Never derive a gender dimension from `relationship` anywhere queries
// against this table — spec §1.5's explicit hard no.
//
// NOTE: the privacy-notice copy update spec 9.20 requires "live before the
// first event logs" is an external document (splitkid.com/privacy, per
// lib/emailTemplates/layout.ts's footer link) — outside this codebase's
// reach. Flagged, not silently assumed done: confirm that copy ships before
// this goes to production, since this migration/instrumentation alone
// cannot satisfy that requirement.
model AccessGrantEvent {
  id                  String            @id @default(cuid())
  relationship        RelationshipType
  // Null only for a bootstrap grant (direct child creation) — there is no
  // inviter. Set for every invite-accept/accept-as-me grant, from that
  // inviter's own relationship on the same child.
  inviterRelationship RelationshipType?
  // Null only for a bootstrap grant. For an invite-accept grant, the gap
  // between the invite being created and this account accepting it — the
  // "time-to-accept" metric spec §1.5 calls out as the growth-funnel number
  // that actually matters.
  timeToAcceptMs      Int?
  createdAt           DateTime          @default(now())

  @@map("access_grant_events")
}

// ---------------------------------------------------------------------------
// Medical / growth
// ---------------------------------------------------------------------------

enum MedicalInfoCategory {
  ALLERGY
  CONDITION
}

model MedicalInfo {
  id            String              @id @default(cuid())
  childId       String
  child         Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  category      MedicalInfoCategory @default(CONDITION)
  condition     String
  description   String?
  emergencyNote String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // NOTE: this table holds sensitive health data (PRD 1.B). Encrypt at rest
  // and gate exports/deletes per the GDPR notes in the architecture doc
  // before this ships to real users.

  @@map("medical_info")
}

// Per-country default checkup/vaccination schedule, used to build the
// "what's coming next" view in the child profile.
model MedicalScheduleTemplate {
  id               String   @id @default(cuid())
  countryCode      String
  label            String
  ageInMonths      Int
  category         String // e.g. "dental", "vaccination", "checkup", "school_health"
  description      String?
  provider         String? // e.g. "General Practitioner (GP)", "Municipal Dental Care"
  isRecurring      Boolean  @default(false)
  recurrenceMonths Int? // only set when isRecurring — months between auto-generated occurrences

  occurrences ChildScheduleOccurrence[]

  @@map("medical_schedule_templates")
}

model GrowthEntry {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  measuredAt DateTime
  heightCm  Float?
  weightKg  Float?
  note      String?
  createdAt DateTime @default(now())

  @@map("growth_entries")
}

// Tracks a child's progress against a MedicalScheduleTemplate item — turns
// the static per-country template list into the "X% Complete" progress bar
// (Medical Progress) in the medical_info_schedules mockup. sequence 0 is the
// template's normal (and for non-recurring templates, only) occurrence;
// sequence 1, 2, ... are auto-generated future instances of a recurring
// template (e.g. the ongoing dental screening, every 12 months), created by
// the API once the prior occurrence is completed — see schedule.ts.
model ChildScheduleOccurrence {
  id          String                  @id @default(cuid())
  childId     String
  child       Child                   @relation(fields: [childId], references: [id], onDelete: Cascade)
  templateId  String
  template    MedicalScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sequence    Int                     @default(0)
  plannedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([childId, templateId, sequence])
  @@map("child_schedule_occurrences")
}

enum EmergencyContactCategory {
  FAMILY
  MEDICAL
  OTHER
}

// Manually-added contacts (pediatrician, dentist, school, poison control —
// per the emergency_contacts mockup). Family members who are already
// ChildAccess users are derived at read time instead of duplicated here;
// see the emergencyContacts route.
model EmergencyContact {
  id        String                    @id @default(cuid())
  childId   String
  child     Child                     @relation(fields: [childId], references: [id], onDelete: Cascade)
  category  EmergencyContactCategory
  name      String
  role      String
  phone     String
  location  String?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@map("emergency_contacts")
}

// ---------------------------------------------------------------------------
// Calendar / custody
// ---------------------------------------------------------------------------

enum CalendarEventCategory {
  CUSTODY
  APPOINTMENT
  MEDICAL
  SCHOOL
  ACTIVITY
  HOLIDAY
  PLANNED_HOLIDAY
}

enum SwapRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

// One active plan per child. `patternDays` is a structured recurrence rule
// (see packages/shared/src/custody.ts's CustodyPattern type + resolveCustodyForDate)
// interpreted on read rather than materialized into CalendarEvent rows — who
// has the child on a given day is a pure function of this plan, so there's
// nothing to keep in sync.
model CustodyPlan {
  id          String   @id @default(cuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  label       String   // e.g. "Week on/week off", "2-2-3"
  patternDays Json
  startDate   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("custody_plans")
}

// Discrete calendar records only — appointments, planned/vacation holidays
// (parent-entered), and system-seeded national holidays. Recurring custody
// days are computed, not stored here (see CustodyPlan above).
model CalendarEvent {
  id        String                @id @default(cuid())
  childId   String
  child     Child                 @relation(fields: [childId], references: [id], onDelete: Cascade)
  category  CalendarEventCategory
  title     String
  startsAt  DateTime
  endsAt    DateTime?
  allDay    Boolean               @default(false)
  notes     String?
  location  String?
  // Free-text note on who/what this event is for beyond the assigned
  // child(ren) — e.g. "Leo & Maya" vs. a single-child default, or a plain
  // note like "Whole family". Purely descriptive; assignment itself is
  // still one CalendarEvent row per assigned child (see EventFormPage's
  // "Both" picker) — this is not a relation.
  assignedNote String?
  // Optional contact card shown on the event (doctor's office, coach,
  // school office, ...). Both null = no contact card rendered.
  contactName   String?
  contactDetail String?
  // Opt-in per event: when true, family members can mark themselves as
  // "confirmed" for this event (see CalendarEventConfirmation below). Not
  // implied by category — a creator turns it on explicitly.
  confirmable Boolean               @default(false)
  checklistItems  CalendarEventChecklistItem[]
  confirmations   CalendarEventConfirmation[]
  // Weekly recurrence — null means a one-off event. When set, this row is
  // the recurring series' anchor: `startsAt`/`endsAt` are the first
  // occurrence's date+time, and later occurrences fall every N weeks after
  // that. Occurrences aren't stored as separate rows — the calendar range
  // endpoint expands them on read (see calendar.ts) — so there's no
  // per-occurrence editing/exceptions; editing or deleting this row edits or
  // deletes the whole series. `recurrenceEndsAt` is optional — null repeats
  // indefinitely (safe: expansion is bounded by whatever range is queried,
  // never generated eagerly).
  recurrenceIntervalWeeks Int?
  recurrenceEndsAt        DateTime?
  // Set once the day-before push reminder has been sent, so the daily
  // remind-appointments job (chunk 8) doesn't double-send.
  remindedAt DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  // Back-relation for ListItem.calendarEventId (Wishlist-linked events).
  // Many-to-one: more than one wishlist item can share the same event (e.g.
  // several gift ideas all tied to the same "Birthday" event).
  listItems ListItem[]

  @@map("calendar_events")
}

// A short, freeform checklist attached to a CalendarEvent (e.g. "Bring:
// swim bag", "Bring: signed permission slip"). Full-replace on edit
// (delete-then-recreate) — see PATCH /calendar-events/:id — so `id` is not
// meaningful across edits; per-item toggling (PATCH .../checklist/:itemId)
// is the only thing that mutates a row in place.
model CalendarEventChecklistItem {
  id              String        @id @default(cuid())
  calendarEventId String
  calendarEvent   CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  label           String
  isChecked       Boolean       @default(false)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("calendar_event_checklist_items")
}

// One row per family member who has confirmed a `confirmable` CalendarEvent
// (e.g. "Both parents confirmed" on a custody handover). Self-service only
// — PATCH /calendar-events/:id/confirm always acts on the caller's own
// userId, upserting or deleting this row; there's no confirming on behalf
// of someone else.
model CalendarEventConfirmation {
  id              String        @id @default(cuid())
  calendarEventId String
  calendarEvent   CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  confirmedAt     DateTime      @default(now())

  @@unique([calendarEventId, userId])
  @@map("calendar_event_confirmations")
}

// Requests to swap a computed custody day, not tied to a stored CalendarEvent
// row (there isn't one — custody days are computed, see CustodyPlan above).
model SwapRequest {
  id            String            @id @default(cuid())
  childId       String
  child         Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  date          DateTime
  requestedById String
  requestedBy   User              @relation("SwapRequestedBy", fields: [requestedById], references: [id])
  status        SwapRequestStatus @default(PENDING)
  message       String?
  createdAt     DateTime          @default(now())
  resolvedAt    DateTime?

  @@map("swap_requests")
}

// Post-launch backlog Phase C — a real request/approve workflow for
// FAMILY/Caregiver members, closing the Phase 3 scope cut that denied
// `calendar_event:manage` to them outright. Close sibling of SwapRequest
// above: same status enum reused (not duplicated), same
// create/approve/decline shape. Approving creates the real `CalendarEvent`
// row (see calendarEventRequests.ts) rather than this row ever becoming
// one in place — keeps "what did the requester ask for" and "what actually
// got scheduled" as two distinct, independently-editable records, same as
// SwapRequest never becomes the custody day it's about.
model CalendarEventRequest {
  id            String            @id @default(cuid())
  childId       String
  child         Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  category      CalendarEventCategory
  title         String
  startsAt      DateTime
  endsAt        DateTime?
  notes         String?
  requestedById String
  requestedBy   User              @relation("CalendarEventRequestedBy", fields: [requestedById], references: [id])
  status        SwapRequestStatus @default(PENDING)
  message       String?
  createdAt     DateTime          @default(now())
  resolvedAt    DateTime?

  @@map("calendar_event_requests")
}

// ---------------------------------------------------------------------------
// Journal / media
// ---------------------------------------------------------------------------

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaAssetStatus {
  PROCESSING
  READY
  FAILED
}

model MediaAsset {
  id               String           @id @default(cuid())
  ownerId          String
  owner            User             @relation(fields: [ownerId], references: [id])
  type             MediaType
  status           MediaAssetStatus @default(PROCESSING)
  originalPath     String           // lossless original, local disk path (see DEPLOYMENT.md storage note)
  derivedPath      String?          // compressed WebP derivative (or JPEG poster for video) for in-app viewing
  // Bug fix — videos weren't playing in most browsers: originalPath is
  // whatever codec/container the uploading phone produced (iPhones commonly
  // record HEVC-in-.mov, which only Safari/macOS/iOS decode), and playback
  // used originalPath directly with no transcoding at all. This is a real
  // H.264/AAC-in-MP4 transcode of the video (see worker.ts's processVideo),
  // broadly playable everywhere — GET /media/:id?variant=original serves
  // this when present, falling back to originalPath only if transcoding
  // hasn't completed/failed. Null for images and for videos still PROCESSING.
  playablePath     String?
  width            Int?
  height           Int?
  journalPostId    String?
  journalPost      JournalPost?     @relation(fields: [journalPostId], references: [id])
  // At most one of these two is set at a time — the asset currently in use
  // as a given user's/child's profile photo. @unique enforces "at most one
  // current avatar asset per user/child"; swapping to a new photo clears the
  // old asset's FK first (see PATCH /auth/me, PATCH /children/:childId).
  avatarForUserId  String?          @unique
  avatarForUser    User?            @relation("UserAvatar", fields: [avatarForUserId], references: [id])
  avatarForChildId String?          @unique
  avatarForChild   Child?           @relation("ChildAvatar", fields: [avatarForChildId], references: [id])
  // Same 1:1-current-asset pattern as the avatar fields above, for a
  // Necessity/Wishlist item's single photo.
  listItemImageForId String?        @unique
  listItemImageFor   ListItem?      @relation("ListItemImage", fields: [listItemImageForId], references: [id])
  createdAt        DateTime         @default(now())

  @@map("media_assets")
}

model JournalPost {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  title     String
  // Description is optional — only the title is required to post. Empty
  // posts (media-only, or just a title) store this as null rather than "".
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children  JournalPostChild[]
  media     MediaAsset[]
  comments  Comment[]
  reactions JournalReaction[]

  @@map("journal_posts")
}

// Join table letting one journal post tag several children — they share one
// comment/reaction thread and each tagged child's journal shows the post.
model JournalPostChild {
  id            String      @id @default(cuid())
  journalPostId String
  journalPost   JournalPost @relation(fields: [journalPostId], references: [id], onDelete: Cascade)
  childId       String
  child         Child       @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([journalPostId, childId])
  @@map("journal_post_children")
}

model Comment {
  id            String      @id @default(cuid())
  journalPostId String
  journalPost   JournalPost @relation(fields: [journalPostId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  text          String
  createdAt     DateTime    @default(now())

  @@map("comments")
}

// Toggleable "Love" reaction on a journal post — one per user per post.
model JournalReaction {
  id            String      @id @default(cuid())
  journalPostId String
  journalPost   JournalPost @relation(fields: [journalPostId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([journalPostId, userId])
  @@map("journal_reactions")
}

// ---------------------------------------------------------------------------
// Lists
// ---------------------------------------------------------------------------

enum ListItemType {
  NECESSITY
  WISHLIST
}

model ListItem {
  id           String       @id @default(cuid())
  childId      String
  child        Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  type         ListItemType
  title        String
  description  String?
  sizeValue    String?      // e.g. clothing/shoe size pulled from the child's profile at creation time
  // Necessities: real delegation — any family member can assign/reassign this
  // to any other family member (not just claim it for themselves).
  assignedToId String?
  assignedTo   User?        @relation("ListItemAssignedTo", fields: [assignedToId], references: [id])
  // Wishlist: self-claim/"Reserve" — whoever claims it is giving that gift.
  claimedById  String?
  claimedBy    User?        @relation("ListItemClaimedBy", fields: [claimedById], references: [id])
  // Wishlist only: an optional linked calendar event (e.g. "Birthday
  // Present" tied to the birthday itself) created alongside the item so it
  // also shows up on the Calendar. Many-to-one — more than one wishlist item
  // can share the same event (several gift ideas tied to one "Birthday").
  // SetNull (not Cascade) so deleting the event just un-links it rather than
  // destroying the underlying wishlist idea.
  calendarEventId String?
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  // Single optional photo (e.g. a picture of the item needed/wanted) — the
  // owning FK lives on MediaAsset (see MediaAsset.listItemImageForId), same
  // 1:1-current-asset pattern as Child/User avatars.
  image        MediaAsset?  @relation("ListItemImage")
  createdAt    DateTime     @default(now())

  @@map("list_items")
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

model Thread {
  id        String         @id @default(cuid())
  isGroup   Boolean        @default(false)
  createdAt DateTime       @default(now())

  members  ThreadMember[]
  messages Message[]

  @@map("threads")
}

model ThreadMember {
  id         String    @id @default(cuid())
  threadId   String
  thread     Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stamped to now() whenever this member fetches the thread's messages —
  // powers the unread badge on the thread list (chunk 6).
  lastReadAt DateTime?

  @@unique([threadId, userId])
  @@map("thread_members")
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])
  text      String?
  mediaId   String?
  createdAt DateTime @default(now())

  @@map("messages")
}

model PersonalNote {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  category  NoteCategory?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("personal_notes")
}

enum NoteCategory {
  ROUTINE
  MILESTONE
  HEALTH
  GENERAL
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  TRIALING
  PENDING // checkout started, awaiting QuickPay webhook confirmation
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

model Subscription {
  id                     String             @id @default(cuid())
  ownerId                String             @unique
  owner                  User               @relation(fields: [ownerId], references: [id])
  tier                   SubscriptionTier   @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  billingPeriod          BillingPeriod?
  quickpaySubscriptionId String?
  quickpayCustomerId     String?
  // Display/billing-history concept only as of Phase 7 — "this subscription
  // itself was created via the 30-day-trial invite-accept path." The
  // entitlement-relevant trial (I-2, spec §2.2) is User.trialStartedAt/
  // trialEndsAt instead: a per-person clock that survives this
  // subscription's own status changing (upgrade, cancel, etc.), which this
  // field deliberately does not.
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  // Phase 8 (spec §4.2/9.12) — set the moment this subscription's status
  // transitions to PAST_DUE, cleared the moment it recovers. Lets
  // apps/api/src/lib/entitlement.ts grant a 7-day grace window during which
  // a PAST_DUE subscription still counts at its pre-failure tier, rather
  // than dropping coverage the instant a charge fails.
  pastDueSince           DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@map("subscriptions")
}

// Phase 7 (spec §8) — which subscription(s) currently satisfy which
// child, per packages/shared/src/entitlement.ts's isSatisfied(). Not the
// source of truth for gating (apps/api/src/lib/entitlement.ts computes that
// live, on every request, from ChildAccess + Subscription + User trial
// fields directly — so a sync bug here can never produce an incorrect
// gate) — this table is best-effort observability/history, written
// alongside that computation. `since` is when this pairing first started
// satisfying, for Phase 8's grace-period math. Population is deferred:
// Phase 7 creates the table; Phase 8 is its first real writer/reader.
model ChildCoverage {
  childId        String
  subscriptionId String
  since          DateTime @default(now())

  @@id([childId, subscriptionId])
  @@map("child_coverage")
}

enum UpgradeRequestStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// Phase 8 (spec §2.3) — "ask [a co-parent] to upgrade" instead of paying
// yourself: a lightweight ask, not a payment mechanism (the recipient still
// subscribes themselves via the existing POST /billing/subscribe — nothing
// here moves money). RESOLVED means the child became satisfied while this
// request was pending (by anyone's action, not necessarily the person
// asked); DISMISSED means a recipient explicitly declined.
model UpgradeRequest {
  id            String               @id @default(cuid())
  childId       String
  child         Child                @relation(fields: [childId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                 @relation(fields: [requestedById], references: [id])
  requiredTier  SubscriptionTier
  status        UpgradeRequestStatus @default(PENDING)
  createdAt     DateTime             @default(now())
  resolvedAt    DateTime?

  @@map("upgrade_requests")
}

// Phase 10 (spec 9.21, §1.4a.4) — "all PARENT members must confirm; if the
// child has no PARENT member, all GUARDIAN members may confirm instead" is a
// live, recomputed-on-every-confirm check (apps/api/src/lib/deletion.ts),
// never a snapshot taken at request time — a member who joins or leaves
// after the request was opened is picked up correctly rather than working
// off a stale required set. `confirmedByIds` needs no join table (Postgres
// native array, via Prisma's String[]) since it's never queried by element,
// only ever read/written as a whole set. `childId` unique: at most one
// pending request per child at a time.
model ChildDeletionRequest {
  id             String   @id @default(cuid())
  childId        String   @unique
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  requestedById  String
  confirmedByIds String[] @default([])
  createdAt      DateTime @default(now())

  @@map("child_deletion_requests")
}

// ---------------------------------------------------------------------------
// Push notifications
// ---------------------------------------------------------------------------

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// Notification preferences
// ---------------------------------------------------------------------------

// One row per user, upserted on read (same pattern as Subscription). No
// `pushEnabled` field here — Push Notifications stays wired to the real
// PushSubscription-existing-or-not mechanism, not a boolean that could drift
// out of sync with actual browser permission state.
model NotificationPreferences {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled              Boolean  @default(false)
  googleCalendarSyncEnabled Boolean  @default(false)
  office365SyncEnabled      Boolean  @default(false)
  categoryCalendar          Boolean  @default(true)
  categoryJournal           Boolean  @default(true)
  categoryLists             Boolean  @default(false)
  categoryMessages          Boolean  @default(true)
  doNotDisturb              Boolean  @default(true)
  quietHoursFrom            String   @default("21:00") // 24h "HH:MM"
  quietHoursTo              String   @default("07:00")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("notification_preferences")
}
